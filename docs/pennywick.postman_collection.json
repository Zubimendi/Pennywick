          }
        },
        {
          "name": "Login (Second User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.collectionVariables.set('secondAuthToken', data.token);",
                  "pm.collectionVariables.set('secondUserId', data.record.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identity\": \"other@pennywick.local\",\n  \"password\": \"OtherPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/collections/users/auth-with-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "collections", "users", "auth-with-password"]
