{
  "info": {
    "_postman_id": "pennywick-expense-tracker-api",
    "name": "Pennywick Expense Tracker API",
    "description": "Complete API test collection for Pennywick expense tracker with PocketBase backend.\n\nAll monetary amounts are stored as integer minor units (kobo for NGN: ₦1,500.00 = 150000 kobo).\nDates use local calendar strings (YYYY-MM-DD), month_key (YYYY-MM), and integer epoch millisecond timestamps (client_updated_at).\nDeletes are soft deletes (setting deleted_at).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set('timestamp', Date.now().toString());"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8090", "type": "string" },
    { "key": "authToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "secondAuthToken", "value": "", "type": "string" },
    { "key": "secondUserId", "value": "", "type": "string" },
    { "key": "categoryId", "value": "", "type": "string" },
    { "key": "incomeCategoryId", "value": "", "type": "string" },
    { "key": "transactionId", "value": "", "type": "string" },
    { "key": "incomeTransactionId", "value": "", "type": "string" },
    { "key": "budgetId", "value": "", "type": "string" },
    { "key": "ruleId", "value": "", "type": "string" },
    { "key": "monthlyRuleId", "value": "", "type": "string" },
    { "key": "syncCursor", "value": "2024-01-01 00:00:00.000Z", "type": "string" },
    { "key": "timestamp", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "description": "User registration, password login, and JWT token refresh.",
      "item": [
        {
          "name": "Sign Up (Primary User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 or 400 (if already exists)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    pm.collectionVariables.set('userId', data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@pennywick.local\",\n  \"password\": \"Pass123456!\",\n  \"passwordConfirm\": \"Pass123456!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/collections/users/records",
              "host": ["{{baseUrl}}"],
              "path": ["api", "collections", "users", "records"]
            }
          }
        },
        {
          "name": "Login (Primary User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test('Token returned', function () {",
                  "    pm.expect(data.token).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('authToken', data.token);",
                  "pm.collectionVariables.set('userId', data.record.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identity\": \"user@pennywick.local\",\n  \"password\": \"Pass123456!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/collections/users/auth-with-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "collections", "users", "auth-with-password"]
            }
          }
        },
