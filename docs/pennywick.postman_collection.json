      "item": [
        {
          "name": "Create Budget (₦60,000 for Transport = 6000000 kobo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 Created', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test('Limit is 6000000 kobo', function () {",
                  "    pm.expect(data.limit_minor).to.eql(6000000);",
                  "});",
                  "pm.collectionVariables.set('budgetId', data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner\": \"{{userId}}\",\n  \"category\": \"{{categoryId}}\",\n  \"limit_minor\": 6000000,\n  \"client_updated_at\": {{timestamp}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/collections/budgets/records",
              "host": ["{{baseUrl}}"],
              "path": ["api", "collections", "budgets", "records"]
