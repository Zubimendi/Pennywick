    {
      "name": "6. Sync Protocol",
      "description": "Cursor pull (200/page), push coalescing, LWW timestamp tracking, and conflict 409 handling.",
      "item": [
        {
          "name": "Pull Changes (Cursor >= timestamp)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test('Page size is <= 200', function () {",
                  "    pm.expect(data.perPage).to.be.at.most(200);",
                  "});",
                  "if (data.items.length > 0) {",
                  "    pm.collectionVariables.set('syncCursor', data.items[data.items.length - 1].updated);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/collections/transactions/records?filter=(updated>='{{syncCursor}}')&sort=updated,id&perPage=200",
              "host": ["{{baseUrl}}"],
              "path": ["api", "collections", "transactions", "records"],
              "query": [
                { "key": "filter", "value": "(updated>='{{syncCursor}}')" },
                { "key": "sort", "value": "updated,id" },
                { "key": "perPage", "value": "200" }
              ]
            }
          }
        },
        {
          "name": "Push Create (Offline Transaction Enqueue)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 Created', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.collectionVariables.set('syncTransactionId', data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner\": \"{{userId}}\",\n  \"kind\": \"expense\",\n  \"amount_minor\": 450000,\n  \"category\": \"{{categoryId}}\",\n  \"occurred_on\": \"2026-11-16\",\n  \"month_key\": \"2026-11\",\n  \"note\": \"Queued offline outbox drain test\",\n  \"client_updated_at\": {{timestamp}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/collections/transactions/records",
              "host": ["{{baseUrl}}"],
              "path": ["api", "collections", "transactions", "records"]
            }
          }
        },
        {
          "name": "Push Conflict (Stale client_updated_at -> Expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409 Conflict (or handled by PB hook)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([409, 400]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount_minor\": 500000,\n  \"client_updated_at\": 1000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/collections/transactions/records/{{syncTransactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "collections", "transactions", "records", "{{syncTransactionId}}"]
            }
          }
        }
      ]
